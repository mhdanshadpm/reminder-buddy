{
  "name": "remind-buddy",
  "productName": "Remind Buddy",
  "version": "2.0.0",
  "description": "A general-purpose desktop reminder with an animated buddy, flexible schedules, and rich history.",
  "main": "main.js",
  "author": "Remind Buddy",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --open-settings",
    "test": "node --test test/reminder-scheduler.test.js test/data.test.js test/characters.test.js",
    "test:e2e": "node test/e2e.test.js && node test/ui.e2e.test.js",
    "test:all": "npm test && npm run test:e2e",
    "assets": "node scripts/generate-assets.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5"
  }
}
